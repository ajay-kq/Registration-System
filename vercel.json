{
    "version": 2,
    "builds": [
        {
            "src": "api/register.js",
            "use": "@vercel/node"
        },
        {
            "src": "api/reset.js",
            "use": "@vercel/node"
        },
        {
            "src": "index.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/register",
            "dest": "/api/register.js"
        },
        {
            "src": "/api/reset",
            "dest": "/api/reset.js"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}